rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function inviteOk() {
      return request.resource.data.inviteCode == get(/databases/$(database)/documents/settings/company).data.inviteCode;
    }
    function validProfile(d) {
      return d.name is string && d.name.size() > 1 && d.name.size() < 80
        && d.role is string && d.role.size() < 80
        && d.phone is string && d.phone.size() < 30
        && d.email is string && d.email.size() < 120
        && d.slug is string && d.slug.matches('^[a-z0-9-]{3,40}$')
        && d.active is bool
        && (!('photo' in d) || (d.photo is string && d.photo.size() < 200000));
    }

    // Public cards. Anyone can read an active profile; owners and admins can read their own either way.
    match /profiles/{slug} {
      allow read: if resource == null || resource.data.active == true || (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.slug == slug
        && validProfile(request.resource.data)
        && inviteOk();
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.slug == slug
        && validProfile(request.resource.data);
      allow update: if isAdmin();   // admins can deactivate or fix any profile
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // One doc per account, pointing at that person's profile slug.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Company settings (invite code lives here). Never readable by the public.
    match /settings/{doc} {
      allow read, write: if isAdmin();
    }

    // Admin list: one doc per admin uid. Managed in the console.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
